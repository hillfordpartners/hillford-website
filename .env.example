# Copy to .env.local and fill in real values when integrations go live.
# All keys are PUBLIC_ (exposed to the client) — do not put secrets here.

# Formspree form ID — activates the contact form (see https://formspree.io)
PUBLIC_FORMSPREE_ID=PLACEHOLDER

# Calendly booking link for consultation scheduling
PUBLIC_CALENDLY_URL=https://calendly.com/hillfordpartners/meeting

# Plausible analytics domain
PUBLIC_PLAUSIBLE_DOMAIN=hillfordpartners.com

# Public contact email shown on the site
PUBLIC_CONTACT_EMAIL=hello@hillfordpartners.com
