---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TeamMember from '../components/TeamMember.astro';
import {
  services,
  team,
  valuePillars,
  stats,
  whyOutsource,
  testimonials,
  softwarePartners,
} from '../data/site';
---

<BaseLayout title="Outsourced Accounting, Bookkeeping & CA Services">
  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-forest text-cream">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <!-- Subtle ledger / trial-balance motif -->
      <svg class="h-full w-full" viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" fill="none">
        {Array.from({ length: 9 }).map((_, i) => (
          <line x1="0" y1={i * 48 + 20} x2="800" y2={i * 48 + 20} stroke="currentColor" stroke-width="1" />
        ))}
        <line x1="560" y1="0" x2="560" y2="400" stroke="currentColor" stroke-width="1" />
        <line x1="680" y1="0" x2="680" y2="400" stroke="currentColor" stroke-width="1" />
      </svg>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="max-w-3xl">
        <p class="mb-4 inline-block rounded-full border border-brass/40 px-4 py-1 text-sm font-medium text-brass-light">
          Outsourced finance, delivered with care
        </p>
        <h1 class="text-4xl leading-tight sm:text-5xl lg:text-6xl">
          Outsourced accounting, bookkeeping &amp; CA services for firms and businesses worldwide.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-cream/80">
          HillFord Partners is your dependable finance back-office — accurate, secure and scalable. We help accounting
          firms expand capacity and businesses outsource their finance function with confidence.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact" class="rounded-full bg-brass px-7 py-3 font-semibold text-forest transition-colors hover:bg-brass-light">
            Book a Consultation
          </a>
          <a href="/services" class="rounded-full border border-cream/40 px-7 py-3 font-semibold text-cream transition-colors hover:border-cream">
            Explore Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Audience selector -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      <a href="/services" class="group rounded-2xl border border-brass/20 bg-white p-8 transition-all hover:border-brass hover:shadow-lg">
        <span class="text-sm font-semibold uppercase tracking-wider text-brass">For accounting / CPA firms</span>
        <h2 class="mt-2 text-2xl text-forest">Scale your practice without scaling headcount</h2>
        <p class="mt-3 text-stone">
          Offload preparation, bookkeeping and audit support to a chartered team that works as a seamless extension of
          your firm.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 font-semibold text-forest">
          See firm services
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
      <a href="/services" class="group rounded-2xl border border-brass/20 bg-white p-8 transition-all hover:border-brass hover:shadow-lg">
        <span class="text-sm font-semibold uppercase tracking-wider text-brass">For businesses</span>
        <h2 class="mt-2 text-2xl text-forest">A finance team, without the overhead</h2>
        <p class="mt-3 text-stone">
          From bookkeeping to reporting and payroll, get plain-English finance support that keeps you compliant and
          focused on growth.
        </p>
        <span class="mt-4 inline-flex items-center gap-1 font-semibold text-forest">
          See business services
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    </div>
  </section>

  <!-- 3. Value pillars -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          valuePillars.map((pillar) => (
            <div>
              <div class="mb-3 h-1 w-10 rounded bg-brass" />
              <h3 class="text-lg text-forest">{pillar.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone">{pillar.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Service highlights -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-2xl">
      <h2 class="text-3xl text-forest sm:text-4xl">What we do</h2>
      <p class="mt-3 text-stone">Seven service lines covering the full finance function — pick what you need, scale as you grow.</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <!-- 5. Why outsource -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="text-3xl text-forest sm:text-4xl">Why outsource to HillFord</h2>
          <p class="mt-4 text-stone">
            We pair Big Four and multinational pedigree with a global delivery model — giving you senior expertise,
            governance and confidentiality at a predictable cost.
          </p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          {
            whyOutsource.map((item) => (
              <div class="rounded-xl bg-cream p-5">
                <h3 class="text-base text-forest">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-stone">{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Credibility band (animated counters) -->
  <section class="bg-forest text-cream">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div>
              <div
                class="font-serif text-4xl font-bold text-brass-light sm:text-5xl"
                data-counter
                data-target={stat.value}
                data-suffix={stat.suffix}
              >
                0{stat.suffix}
              </div>
              <p class="mt-2 text-sm text-cream/80">{stat.label}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-center text-xs text-cream/50">Figures indicative — confirmed metrics published at launch.</p>
    </div>
  </section>

  <!-- 7. Leadership teaser -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="text-3xl text-forest sm:text-4xl">Led by chartered accountants</h2>
        <p class="mt-3 text-stone">Our leadership brings audit, advisory and reporting expertise from leading global firms.</p>
      </div>
      <a href="/team" class="inline-flex items-center gap-1 font-semibold text-brass hover:text-forest">
        Meet the team
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-3">
      {team.map((member) => <TeamMember member={member} teaser />)}
    </div>
  </section>

  <!-- 8. Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="mb-10 text-3xl text-forest sm:text-4xl">What clients say</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          testimonials.map((t) => (
            <figure class="rounded-xl border border-brass/20 bg-cream p-8">
              <svg class="mb-4 h-8 w-8 text-brass" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M9 7H5a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h2v1a2 2 0 0 1-2 2 1 1 0 0 0 0 2 4 4 0 0 0 4-4V8a1 1 0 0 0-1-1Zm10 0h-4a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h2v1a2 2 0 0 1-2 2 1 1 0 0 0 0 2 4 4 0 0 0 4-4V8a1 1 0 0 0-1-1Z" />
              </svg>
              <blockquote class="text-lg leading-relaxed text-charcoal">“{t.quote}”</blockquote>
              <figcaption class="mt-4 text-sm font-semibold text-forest">
                {t.author} <span class="font-normal text-stone">— {t.company}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 9. Software & tools strip -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <p class="mb-8 text-center text-sm font-semibold uppercase tracking-wider text-stone">
      We work across the platforms you already use
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      {
        softwarePartners.map((name) => (
          <span class="text-lg font-semibold text-forest/40">{name}</span>
        ))
      }
    </div>
  </section>

  <!-- 10. Insights teaser -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl text-forest sm:text-4xl">Insights &amp; resources</h2>
        <a href="/blog" class="inline-flex items-center gap-1 font-semibold text-brass hover:text-forest">
          Visit the blog
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        {
          [
            'How to choose an accounting outsourcing partner',
            'Building audit-ready books all year round',
            'Outsourced bookkeeping: a guide for CPA firms',
          ].map((title) => (
            <article class="flex flex-col rounded-xl border border-brass/20 bg-cream p-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-brass">Coming soon</span>
              <h3 class="mt-2 text-lg text-forest">{title}</h3>
              <p class="mt-2 flex-1 text-sm text-stone">Thought-leadership and practical guidance — publishing shortly.</p>
              <span class="mt-4 text-sm font-semibold text-stone/60">Article in progress</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 11. Closing CTA band with call-back form -->
  <section class="bg-forest text-cream">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
      <div>
        <h2 class="text-3xl text-cream sm:text-4xl">Get a call back</h2>
        <p class="mt-4 max-w-md text-cream/80">
          Leave your details and a member of our team will reach out to understand your needs and outline how HillFord
          can help.
        </p>
      </div>
      <form class="grid gap-4 rounded-2xl bg-white/5 p-6" data-callback-form novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <input type="text" name="name" required placeholder="Your name" class="rounded-lg border border-cream/20 bg-cream/10 px-4 py-3 text-cream placeholder:text-cream/50 focus:border-brass focus:outline-none" />
          <input type="email" name="email" required placeholder="Email address" class="rounded-lg border border-cream/20 bg-cream/10 px-4 py-3 text-cream placeholder:text-cream/50 focus:border-brass focus:outline-none" />
        </div>
        <input type="tel" name="phone" placeholder="Phone (optional)" class="rounded-lg border border-cream/20 bg-cream/10 px-4 py-3 text-cream placeholder:text-cream/50 focus:border-brass focus:outline-none" />
        <button type="submit" class="rounded-full bg-brass px-7 py-3 font-semibold text-forest transition-colors hover:bg-brass-light">
          Request a call back
        </button>
        <p data-form-note class="hidden text-sm text-brass-light"></p>
      </form>
    </div>
  </section>

  <script>
    // Animated counters on scroll
    const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
    if (counters.length) {
      const animate = (el: HTMLElement) => {
        const target = Number(el.dataset.target ?? '0');
        const suffix = el.dataset.suffix ?? '';
        const duration = 1600;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target).toLocaleString() + suffix;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animate(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );
      counters.forEach((c) => observer.observe(c));
    }

    // Call-back form — placeholder phase: no backend wired yet.
    const form = document.querySelector<HTMLFormElement>('[data-callback-form]');
    const note = document.querySelector<HTMLParagraphElement>('[data-form-note]');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      if (note) {
        note.textContent = 'Thanks! Online enquiries launch shortly — please email us in the meantime and we’ll respond within one business day.';
        note.classList.remove('hidden');
      }
      form.reset();
    });
  </script>
</BaseLayout>
