---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TeamMember from '../components/TeamMember.astro';
import {
  services,
  team,
  valuePillars,
  stats,
  testimonials, 
  softwarePartners,
} from '../data/site';
---

<BaseLayout title="Outsourced Accounting, Bookkeeping & CA Services">

  <!-- ══════════════════════════════════════════════════════════
       1. HERO  ·  Dark midnight bg, brass radial glow
       ══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-midnight text-cream">

    <!-- Radial brass glow behind headline -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -top-40 left-1/2 h-[800px] w-[1000px] -translate-x-1/2 rounded-full"
        style="background: radial-gradient(ellipse at 50% 0%, rgba(168,130,60,0.16) 0%, rgba(168,130,60,0.04) 45%, transparent 72%);"
      ></div>

      <!-- Ledger / trial-balance SVG motif (subtler on dark bg) -->
      <svg
        class="absolute inset-0 h-full w-full opacity-[0.045]"
        viewBox="0 0 1400 700"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
        aria-hidden="true"
      >
        {Array.from({ length: 14 }).map((_, i) => (
          <line x1="0" y1={i * 54 + 16} x2="1400" y2={i * 54 + 16} stroke="white" stroke-width="1" />
        ))}
        <line x1="980"  y1="0" x2="980"  y2="700" stroke="white" stroke-width="1" />
        <line x1="1190" y1="0" x2="1190" y2="700" stroke="white" stroke-width="1" />
      </svg>
    </div>

    <!-- Hero content -->
    <div class="relative mx-auto max-w-7xl px-4 pb-28 pt-24 sm:px-6 lg:px-8 lg:pb-36 lg:pt-32">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
        
        <!-- Left Side Content -->
        <div class="lg:col-span-7">
          <!-- Eyebrow pill -->
          <div
            class="reveal-up mb-8 inline-flex items-center gap-2 rounded-full border border-brass/35 bg-black px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brass-light"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-brass animate-pulse" style="box-shadow: 0 0 8px #a8823c;" aria-hidden="true"></span>
            Outsourced finance, delivered with care
          </div>

          <!-- H1 -->
          <h1
            class="reveal-up font-sans text-[2.75rem] font-bold tracking-tight leading-[1.08] text-cream sm:text-5xl lg:text-[4.25rem]"
            style="animation-delay: 80ms"
          >
            Outsourced accounting,<br class="hidden sm:inline" />bookkeeping &amp; CA services for<br class="hidden sm:inline" />firms &amp; <span class="text-brass border-r-3 border-brass pr-2.5 animate-pulse">businesses worldwide</span>
          </h1>

          <!-- Sub-copy -->
          <p
            class="reveal-up mt-7 max-w-xl text-[1.0625rem] leading-relaxed text-cream/60 lg:text-[1.125rem]"
            style="animation-delay: 160ms"
          >
            HillFord Partners is your dependable finance back-office — accurate, secure and scalable. We help accounting
            firms expand capacity and businesses outsource their finance function with confidence.
          </p>

          <!-- CTA row -->
          <div class="reveal-up mt-10 flex flex-wrap items-center gap-6" style="animation-delay: 240ms">
            <a
              href="/contact"
              id="hero-cta-primary"
              class="group inline-flex items-center gap-2 rounded-full bg-brass px-8 py-4 text-sm font-semibold text-midnight transition-all duration-300 hover:bg-brass-light hover:shadow-[0_4px_32px_rgba(168,130,60,0.45)]"
            >
              Book a Consultation
              <svg class="h-4.5 w-4.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            
            <a href="/services" id="hero-cta-secondary" class="group flex items-center gap-3.5">
              <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/20 bg-white/[0.04] text-cream transition-all duration-300 group-hover:border-brass/40 group-hover:bg-brass/[0.08] group-hover:text-brass-light">
                <svg class="h-5 w-5 translate-x-0.5 fill-current text-brass-light" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <span class="text-sm font-semibold text-cream/70 transition-colors group-hover:text-cream">Explore Services</span>
            </a>
          </div>
        </div>

        <!-- Right Side Image (3D Render) -->
        <div class="relative flex justify-center lg:col-span-5">
          <!-- Radial glow behind image -->
          <div class="pointer-events-none absolute left-1/2 top-1/2 h-[360px] w-[360px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-60" style="background: radial-gradient(circle, rgba(168,130,60,0.18) 0%, transparent 65%);" aria-hidden="true"></div>
          <img
            src="/images/hero-3d.png"
            alt="HillFord 3D Digital Asset Symbol"
            class="animate-float relative z-10 w-full max-w-[340px] object-contain sm:max-w-[380px] lg:max-w-full"
          />
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       2. AUDIENCE SELECTOR  ·  Dark bg, glassmorphism cards
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-midnight-2 border-t border-white/[0.04]">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-5 md:grid-cols-2">

        <!-- For Firms -->
        <a
          href="/services"
          id="audience-firms-card"
          class="group relative overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.04] backdrop-blur-sm p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brass/25 hover:bg-white/[0.07] hover:shadow-[0_10px_44px_rgba(168,130,60,0.1)]"
        >
          <div
            class="pointer-events-none absolute right-0 top-0 h-40 w-40 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            style="background: radial-gradient(circle at top right, rgba(168,130,60,0.07), transparent 70%);"
            aria-hidden="true"
          ></div>
          <span class="text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">For accounting / CPA firms</span>
          <h2 class="mt-3 font-serif text-[1.4375rem] text-cream">Scale your practice without scaling headcount</h2>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-cream/60">
            Offload preparation, bookkeeping and audit support to a chartered team that works as a seamless extension of
            your firm.
          </p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brass transition-colors duration-300 group-hover:text-brass-light">
            See firm services
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- For Businesses -->
        <a
          href="/services"
          id="audience-business-card"
          class="group relative overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.04] backdrop-blur-sm p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brass/25 hover:bg-white/[0.07] hover:shadow-[0_10px_44px_rgba(168,130,60,0.1)]"
        >
          <div
            class="pointer-events-none absolute right-0 top-0 h-40 w-40 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            style="background: radial-gradient(circle at top right, rgba(168,130,60,0.07), transparent 70%);"
            aria-hidden="true"
          ></div>
          <span class="text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">For businesses</span>
          <h2 class="mt-3 font-serif text-[1.4375rem] text-cream">A finance team, without the overhead</h2>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-cream/60">
            From bookkeeping to reporting and payroll, get plain-English finance support that keeps you compliant and
            focused on growth.
          </p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brass transition-colors duration-300 group-hover:text-brass-light">
            See business services
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3. VALUE PILLARS  ·  Dark bg, numbered glass design
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-midnight border-t border-white/[0.04]">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">

      <!-- Section label + heading -->
      <div class="reveal-up mb-14">
        <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">Why HillFord</p>
        <h2 class="font-serif text-3xl text-cream sm:text-4xl">Built on four founding principles</h2>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {valuePillars.map((pillar, i) => (
          <div
            class="reveal-up group"
            style={`animation-delay: ${i * 90}ms`}
            id={`pillar-${i + 1}`}
          >
            <!-- Large faded index number -->
            <div class="mb-4 font-serif text-6xl font-semibold leading-none text-white/[0.03] transition-colors duration-300 group-hover:text-brass/20">
              {String(i + 1).padStart(2, '0')}
            </div>
            <!-- Accent bar -->
            <div class="mb-4 h-px w-10 bg-brass"></div>
            <h3 class="text-[0.9375rem] font-semibold text-cream">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream/60">{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4. SERVICES  ·  Dark bg, premium service cards
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-midnight-2 border-t border-white/[0.04]">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">

      <!-- Section header -->
      <div class="reveal-up mb-12 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-xl">
          <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">What we do</p>
          <h2 class="font-serif text-3xl text-cream sm:text-4xl">Seven services.<br/>One trusted partner.</h2>
          <p class="mt-3 text-[0.9375rem] text-cream/60">Pick what you need, scale as you grow.</p>
        </div>
        <a href="/services" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brass transition-colors hover:text-brass-light">
          View all services
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <!-- Cards grid -->
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, i) => (
          <div class="reveal-up" style={`animation-delay: ${(i % 3) * 80}ms`}>
            <ServiceCard service={service} />
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       5. WHY OUTSOURCE  ·  Dark section, glass reason cards
       ══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-midnight border-t border-white/[0.04] text-cream">

    <!-- Subtle brass glow left side -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -left-40 top-1/2 h-[640px] w-[640px] -translate-y-1/2 rounded-full"
        style="background: radial-gradient(circle, rgba(168,130,60,0.09) 0%, transparent 65%);"
      ></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">

        <!-- Left: heading block -->
        <div class="reveal-up">
          <p class="mb-4 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">The HillFord advantage</p>
          <h2 class="font-serif text-3xl text-cream sm:text-4xl">
            Why outsource to&nbsp;<em class="not-italic text-brass-light">HillFord</em>
          </h2>
          <p class="mt-5 max-w-md text-[0.9375rem] leading-relaxed text-cream/58">
            We pair Big Four and multinational pedigree with a global delivery model — giving you senior expertise,
            governance and confidentiality at a predictable cost.
          </p>
          <a
            href="/about"
            class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-brass transition-colors hover:text-brass-light"
          >
            About HillFord
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>

        <!-- Right: 2×2 glass cards -->
        <div class="grid gap-4 sm:grid-cols-2">
          {whyOutsource.map((item, i) => (
            <div
              class="reveal-up rounded-xl border border-white/[0.08] bg-white/[0.04] p-5 backdrop-blur-sm transition-all duration-300 hover:border-brass/20 hover:bg-white/[0.07]"
              style={`animation-delay: ${i * 80}ms`}
              id={`why-item-${i + 1}`}
            >
              <div class="mb-3 font-serif text-2xl font-semibold leading-none text-brass/25">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="text-sm font-semibold text-cream">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-cream/55">{item.body}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       6. CREDIBILITY STATS  ·  Midnight bg with forest glow
       ══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-midnight-2 border-t border-white/[0.04] text-cream">

    <!-- Centre forest green / brass double glow -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute left-1/2 top-1/2 h-[560px] w-[1000px] -translate-x-1/2 -translate-y-1/2 rounded-full"
        style="background: radial-gradient(ellipse at center, rgba(20,69,47,0.38) 0%, rgba(168,130,60,0.06) 50%, transparent 72%);"
      ></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-10 text-center sm:grid-cols-2 lg:grid-cols-4">
        {stats.map((stat, i) => (
          <div class="reveal-up" style={`animation-delay: ${i * 90}ms`} id={`stat-${i + 1}`}>
            <div
              class="brass-text-glow font-serif text-5xl font-semibold text-brass-light sm:text-6xl"
              data-counter
              data-target={stat.value}
              data-suffix={stat.suffix}
            >
              0{stat.suffix}
            </div>
            <p class="mt-3 text-sm font-medium text-cream/65">{stat.label}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 text-center text-xs text-cream/35">Figures indicative — confirmed metrics published at launch.</p>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       7. LEADERSHIP TEASER  ·  Dark bg, elevated team cards
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-midnight border-t border-white/[0.04]">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">

      <!-- Section header -->
      <div class="reveal-up mb-12 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-xl">
          <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">Our leadership</p>
          <h2 class="font-serif text-3xl text-cream sm:text-4xl">Led by chartered accountants</h2>
          <p class="mt-3 text-[0.9375rem] text-cream/60">
            Our leadership brings audit, advisory and reporting expertise from leading global firms.
          </p>
        </div>
        <a href="/team" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brass transition-colors hover:text-brass-light">
          Meet the team
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <!-- Team cards -->
      <div class="grid gap-6 sm:grid-cols-3">
        {team.map((member, i) => (
          <div class="reveal-up" style={`animation-delay: ${i * 90}ms`}>
            <TeamMember member={member} teaser />
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       8. TESTIMONIALS  ·  Dark surface bg, glass quote cards
       ══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-midnight-2 border-t border-white/[0.04] text-cream">

    <!-- Top-right glow -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute right-0 top-0 h-[440px] w-[640px]"
        style="background: radial-gradient(ellipse at top right, rgba(168,130,60,0.09) 0%, transparent 60%);"
      ></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">

      <div class="reveal-up mb-12">
        <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">Client voices</p>
        <h2 class="font-serif text-3xl text-cream sm:text-4xl">What clients say</h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {testimonials.map((t, i) => (
          <figure
            class="reveal-up rounded-2xl border border-white/[0.08] bg-white/[0.04] p-8 backdrop-blur-sm transition-all duration-300 hover:border-brass/20 hover:bg-white/[0.07]"
            style={`animation-delay: ${i * 120}ms`}
            id={`testimonial-${i + 1}`}
          >
            <!-- Decorative quote mark -->
            <div class="mb-5 font-serif text-5xl leading-none text-brass/35" aria-hidden="true">&ldquo;</div>
            <blockquote class="text-[1.0625rem] leading-relaxed text-cream/85">{t.quote}</blockquote>
            <figcaption class="mt-5 text-sm">
              <span class="font-semibold text-brass-light">{t.author}</span>
              <span class="text-cream/40"> — {t.company}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       9. SOFTWARE STRIP  ·  Dark bg, interactive partner names
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-midnight border-t border-white/[0.04]">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="reveal-up mb-10 text-center text-[0.6875rem] font-semibold uppercase tracking-widest text-cream/50">
        We work across the platforms you already use
      </p>

      <!-- Thin divider lines -->
      <div class="reveal-up flex flex-col items-center gap-6">
        <div class="h-px w-full max-w-2xl bg-gradient-to-r from-transparent via-brass/20 to-transparent"></div>
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
          {softwarePartners.map((name, i) => (
            <span
              class="text-base font-semibold text-cream/30 transition-colors duration-300 hover:text-brass-light"
              id={`partner-${i + 1}`}
            >
              {name}
            </span>
          ))}
        </div>
        <div class="h-px w-full max-w-2xl bg-gradient-to-r from-transparent via-brass/20 to-transparent"></div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       10. INSIGHTS TEASER  ·  Dark bg, blog preview cards
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-midnight-2 border-t border-white/[0.04]">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">

      <!-- Section header -->
      <div class="reveal-up mb-12 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">From the desk</p>
          <h2 class="font-serif text-3xl text-cream sm:text-4xl">Insights &amp; resources</h2>
        </div>
        <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brass transition-colors hover:text-brass-light">
          Visit the blog
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <!-- Blog preview cards -->
      <div class="grid gap-5 sm:grid-cols-3">
        {[
          'How to choose an accounting outsourcing partner',
          'Building audit-ready books all year round',
          'Outsourced bookkeeping: a guide for CPA firms',
        ].map((title, i) => (
          <article
            class="reveal-up flex flex-col rounded-2xl border border-white/[0.08] bg-white/[0.04] p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brass/25 hover:bg-white/[0.07] hover:shadow-[0_10px_36px_rgba(168,130,60,0.08)]"
            style={`animation-delay: ${i * 80}ms`}
            id={`blog-preview-${i + 1}`}
          >
            <span class="text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">Coming soon</span>
            <h3 class="font-serif text-lg text-cream">{title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-cream/60">
              Thought-leadership and practical guidance — publishing shortly.
            </p>
            <span class="mt-5 text-[0.75rem] font-semibold text-cream/40">Article in progress</span>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       11. CLOSING CTA + CALL-BACK FORM  ·  Dark midnight
       ══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-midnight border-t border-white/[0.04] text-cream">

    <!-- Top-centre brass glow -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute left-1/2 top-0 h-[640px] w-[900px] -translate-x-1/2"
        style="background: radial-gradient(ellipse at 50% 0%, rgba(168,130,60,0.15) 0%, transparent 65%);"
      ></div>
      <!-- Subtle ledger lines echoing hero -->
      <svg
        class="absolute inset-0 h-full w-full opacity-[0.025]"
        viewBox="0 0 1400 600"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
        aria-hidden="true"
      >
        {Array.from({ length: 12 }).map((_, i) => (
          <line x1="0" y1={i * 52 + 16} x2="1400" y2={i * 52 + 16} stroke="white" stroke-width="1" />
        ))}
      </svg>
    </div>

    <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-2 lg:items-start lg:gap-16 lg:px-8">

      <!-- Left copy -->
      <div class="reveal-up">
        <p class="mb-4 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">Get in touch</p>
        <h2 class="font-serif text-3xl text-cream sm:text-4xl">Get a call back</h2>
        <p class="mt-5 max-w-md text-[0.9375rem] leading-relaxed text-cream/58">
          Leave your details and a member of our team will reach out to understand your needs and outline how HillFord
          can help.
        </p>
        <!-- Response promise pill -->
        <div class="mt-8 flex items-center gap-3">
          <div class="h-px w-8 bg-brass/40"></div>
          <span class="text-sm text-cream/45">We respond within 1 business day.</span>
        </div>
      </div>

      <!-- Right: glass form card -->
      <div class="reveal-up" style="animation-delay: 120ms">
        <form
          class="rounded-2xl border border-white/[0.08] bg-white/[0.04] p-7 backdrop-blur-sm"
          data-callback-form
          novalidate
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <!-- Name -->
            <div class="flex flex-col gap-1.5">
              <label for="cb-name" class="text-xs font-medium text-cream/55">Your name</label>
              <input
                id="cb-name"
                type="text"
                name="name"
                required
                placeholder="Jane Smith"
                class="rounded-lg border border-white/[0.10] bg-white/[0.06] px-4 py-3 text-sm text-cream placeholder:text-cream/30 transition-all focus:border-brass/50 focus:bg-white/[0.09] focus:outline-none"
              />
            </div>
            <!-- Email -->
            <div class="flex flex-col gap-1.5">
              <label for="cb-email" class="text-xs font-medium text-cream/55">Email address</label>
              <input
                id="cb-email"
                type="email"
                name="email"
                required
                placeholder="jane@firm.com"
                class="rounded-lg border border-white/[0.10] bg-white/[0.06] px-4 py-3 text-sm text-cream placeholder:text-cream/30 transition-all focus:border-brass/50 focus:bg-white/[0.09] focus:outline-none"
              />
            </div>
          </div>

          <!-- Phone -->
          <div class="mt-4 flex flex-col gap-1.5">
            <label for="cb-phone" class="text-xs font-medium text-cream/55">
              Phone <span class="text-cream/30">(optional)</span>
            </label>
            <input
              id="cb-phone"
              type="tel"
              name="phone"
              placeholder="+1 555 000 0000"
              class="rounded-lg border border-white/[0.10] bg-white/[0.06] px-4 py-3 text-sm text-cream placeholder:text-cream/30 transition-all focus:border-brass/50 focus:bg-white/[0.09] focus:outline-none"
            />
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="cta-form-submit"
            class="mt-5 w-full rounded-full bg-brass px-7 py-3.5 text-sm font-semibold text-forest transition-all duration-300 hover:bg-brass-light hover:shadow-[0_4px_28px_rgba(168,130,60,0.32)]"
          >
            Request a call back
          </button>

          <!-- Feedback message (shown after submit) -->
          <p data-form-note class="mt-4 hidden text-sm text-brass-light"></p>
        </form>
      </div>
    </div>
  </section>


  <script>
    // ── Scroll-reveal observer ───────────────────────────────────────────────
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal-up');
    if (revealEls.length) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -36px 0px' }
      );
      revealEls.forEach((el) => revealObserver.observe(el));
    }

    // ── Animated counters ────────────────────────────────────────────────────
    const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
    if (counters.length) {
      const animateCounter = (el: HTMLElement) => {
        const target = Number(el.dataset.target ?? '0');
        const suffix = el.dataset.suffix ?? '';
        const duration = 1800;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target).toLocaleString() + suffix;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const counterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target as HTMLElement);
              counterObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );
      counters.forEach((c) => counterObserver.observe(c));
    }

    // ── Call-back form ───────────────────────────────────────────────────────
    const form = document.querySelector<HTMLFormElement>('[data-callback-form]');
    const note = document.querySelector<HTMLParagraphElement>('[data-form-note]');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      if (note) {
        note.textContent =
          'Thanks! Online enquiries launch shortly — please email us in the meantime and we\u2019ll respond within one business day.';
        note.classList.remove('hidden');
      }
      form.reset();
    });
  </script>

</BaseLayout>
