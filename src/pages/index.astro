---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ManagementSection from '../components/ManagementSection.astro';
import ContactCallbackBand from '../components/ContactCallbackBand.astro';
import {
  services,
  team,
  valuePillars,
  softwarePartners,
  whyOutsource,
  site,
  hasCalendlyLink,
} from '../data/site';

const featuredServices = services.slice(0, 4);

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Outsourced Accounting, Bookkeeping & CA Services">

  <!-- ══════════════════════════════════════════════════════════
       1. HERO  ·  Navy bg, dual CTA + audience feature cards
       ══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-navy text-cream">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -top-40 left-1/2 h-[800px] w-[1000px] -translate-x-1/2 rounded-full"
        style="background: radial-gradient(ellipse at 50% 0%, rgba(212,168,75,0.14) 0%, rgba(212,168,75,0.03) 45%, transparent 72%);"
      ></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 pb-16 pt-10 sm:px-6 lg:px-8 lg:pt-16">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
        <!-- Left: copy -->
        <div class="lg:col-span-7">
          <div class="reveal-up mb-8 inline-flex items-center gap-2 rounded-full border border-brass/35 bg-white/[0.06] px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brass">
            <span class="h-1.5 w-1.5 rounded-full bg-brass" aria-hidden="true"></span>
            Outsourced finance, delivered with care
          </div>

          <h1 class="reveal-up font-serif text-[2.5rem] font-semibold tracking-tight leading-[1.1] text-cream sm:text-5xl lg:text-[3.75rem]" style="animation-delay: 80ms">
            Outsourced Accounting and Finance, Delivered with <span class="text-brass">Confidence.</span>
          </h1>

          <p class="reveal-up mt-5 font-serif text-lg italic text-brass/90" style="animation-delay: 120ms">
            Beyond Numbers. Building Confidence.
          </p>

          <p class="reveal-up mt-5 max-w-xl text-[1.0625rem] leading-relaxed text-cream/70 lg:text-[1.125rem]" style="animation-delay: 160ms">
            HillFord partners with businesses worldwide to deliver expert finance and advisory services. Backed by
            over 50 years of combined experience from a team of Chartered Accountants, we are driven by precision,
            integrity, confidentiality, and robust data security. We help businesses streamline finance, ensure
            compliance, and make confident decisions that drive sustainable growth.
          </p>

          <div class="reveal-up mt-10 flex flex-wrap items-center gap-6" style="animation-delay: 240ms">
            <a
              href={hasCalendlyLink ? site.calendlyUrl : '/contact'}
              target={hasCalendlyLink ? '_blank' : undefined}
              rel={hasCalendlyLink ? 'noopener noreferrer' : undefined}
              class="group inline-flex items-center gap-2 rounded-full bg-brass px-8 py-4 text-sm font-semibold text-navy transition-all duration-300 hover:bg-brass-light"
            >
              Book a Consultation
              <svg class="h-4.5 w-4.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a href="/services" class="group flex items-center gap-3.5">
              <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/20 bg-white/[0.06] text-cream transition-all duration-300 group-hover:border-brass/40 group-hover:bg-brass/[0.12]">
                <svg class="h-5 w-5 translate-x-0.5 fill-current text-brass" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <span class="text-sm font-semibold text-cream/75 transition-colors group-hover:text-cream">Explore Services</span>
            </a>
          </div>
        </div>

        <!-- Right: hero image -->
        <div class="relative flex justify-center lg:col-span-5">
          <img
            src="/images/home-accounting-workspace.webp"
            alt="A modern accounting workspace with a laptop showing financial dashboards"
            width="727"
            height="415"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="reveal-up w-full max-w-xl rounded-2xl object-cover shadow-2xl"
            style="animation-delay: 200ms"
          />
        </div>
      </div>

      <!-- Feature / audience cards -->
      <div class="reveal-up mt-16 grid gap-5 md:grid-cols-2" style="animation-delay: 280ms">
        <a
          href="/services"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06] p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-brass/30 hover:bg-white/[0.09]"
        >
          <span class="text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">For accounting / CPA firms</span>
          <h2 class="mt-3 font-serif text-[1.3125rem] text-cream">Scale your practice without scaling headcount</h2>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-cream/65">
            Offload preparation, bookkeeping and audit support to a chartered team that works as a seamless extension of your firm.
          </p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brass">
            See firm services
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <a
          href="/services"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06] p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-brass/30 hover:bg-white/[0.09]"
        >
          <span class="text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">For businesses</span>
          <h2 class="mt-3 font-serif text-[1.3125rem] text-cream">A finance team, without the overhead</h2>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-cream/65">
            From bookkeeping to reporting and payroll, get plain-English finance support that keeps you compliant and focused on growth.
          </p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brass">
            See business services
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       2. PRINCIPLES  ·  White bg, numbered outline icons
       ══════════════════════════════════════════════════════════ -->
  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="reveal-up mb-14">
        <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass-dark">Why HillFord</p>
        <h2 class="font-serif text-3xl text-navy sm:text-4xl">Built on four founding principles</h2>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {valuePillars.map((pillar, i) => (
          <div class="reveal-up" style={`animation-delay: ${i * 90}ms`}>
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-full border border-brass/40 font-serif text-sm font-semibold text-brass-dark">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="text-[0.9375rem] font-semibold text-navy">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone">{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       3. SERVICES TEASER  ·  White bg, 4-card grid
       ══════════════════════════════════════════════════════════ -->
  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="reveal-up mb-12 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-xl">
          <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass-dark">What we do</p>
          <h2 class="font-serif text-3xl text-navy sm:text-4xl">Seven Services, One Trusted Partner</h2>
          <p class="mt-3 text-[0.9375rem] text-stone">Pick what you need, scale as you grow.</p>
        </div>
        <a href="/services" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brass-dark transition-colors hover:text-navy">
          View all services
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {featuredServices.map((service, i) => (
          <div class="reveal-up" style={`animation-delay: ${i * 80}ms`}>
            <ServiceCard service={service} />
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       4. ADVANTAGE  ·  White bg, reasons list + sticky crossfade image
       ══════════════════════════════════════════════════════════ -->
  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-start">
        <!-- Left: reasons -->
        <div>
          <p class="reveal-up mb-4 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass-dark">The HillFord advantage</p>
          <h2 class="reveal-up font-serif text-3xl text-navy sm:text-4xl">
            Why outsource to&nbsp;<span class="text-brass-dark">HillFord</span>
          </h2>
          <p class="reveal-up mt-5 max-w-md text-[0.9375rem] leading-relaxed text-stone">
            We pair Big Four and multinational pedigree with a global delivery model — giving you senior expertise,
            governance and confidentiality at a predictable cost.
          </p>
          <a href="/about" class="reveal-up mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-brass-dark transition-colors hover:text-navy">
            About HillFord
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <!-- Static image, mobile/tablet only (no sticky/crossfade below lg) -->
          <img
            src="/images/global-finance-collaboration.webp"
            alt="Two finance professionals reviewing reports together during a video call"
            width="900"
            height="675"
            loading="lazy"
            decoding="async"
            class="reveal-up mt-10 w-full rounded-2xl object-cover shadow-lg lg:hidden"
          />

          <ul class="mt-10 space-y-8">
            {whyOutsource.map((item, i) => (
              <li class="reveal-up relative flex gap-4" style={`animation-delay: ${i * 80}ms`}>
                {i === 2 && <span data-crossfade-trigger class="absolute inset-x-0 top-0 h-px" aria-hidden="true"></span>}
                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brass/12 font-serif text-xs font-semibold text-brass-dark">
                  {String(i + 1).padStart(2, '0')}
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-navy">{item.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-stone">{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: sticky crossfade image panel, desktop only -->
        <div class="hidden lg:block">
          <div data-crossfade-panel class="sticky top-28 h-[520px] overflow-hidden rounded-2xl shadow-xl">
            <img
              src="/images/global-finance-collaboration.webp"
              alt="Two finance professionals reviewing reports together during a video call"
              width="900"
              height="675"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <img
              src="/images/accounting-review-process.webp"
              alt="A structured accounting review in progress, with checklists and financial reports"
              width="900"
              height="506"
              loading="lazy"
              decoding="async"
              data-crossfade-image
              class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-out"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // ── Sticky image crossfade for the "Why outsource" section ────────────────
    // Uses a throttled scroll listener rather than IntersectionObserver: this
    // needs continuous "which side of center is the trigger on" tracking as
    // the user scrolls back and forth, not a one-shot visibility check.
    const panel = document.querySelector<HTMLElement>('[data-crossfade-panel]');
    const trigger = document.querySelector<HTMLElement>('[data-crossfade-trigger]');
    const secondImage = panel?.querySelector<HTMLElement>('[data-crossfade-image]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (panel && trigger && secondImage && !reduceMotion) {
      let ticking = false;
      const updateCrossfade = () => {
        const pastCenter = trigger.getBoundingClientRect().top < window.innerHeight / 2;
        secondImage.style.opacity = pastCenter ? '1' : '0';
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateCrossfade);
        }
      };
      updateCrossfade();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  </script>


  <!-- ══════════════════════════════════════════════════════════
       5. LEADERSHIP  ·  Navy bg, detailed profile cards
       ══════════════════════════════════════════════════════════ -->
  <ManagementSection members={team} />


  <!-- ══════════════════════════════════════════════════════════
       6. PLATFORMS  ·  White bg, software partner strip
       ══════════════════════════════════════════════════════════ -->
  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <!-- Software partner strip -->
      <div class="reveal-up flex flex-col items-center gap-6">
        <p class="text-center text-[0.6875rem] font-semibold uppercase tracking-widest text-stone">
          We work across the platforms you already use
        </p>
        <div class="h-px w-full max-w-2xl bg-navy/10"></div>
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
          {softwarePartners.map((name) => (
            <span class="text-base font-semibold text-stone transition-colors duration-300 hover:text-brass-dark">
              {name}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       7. INSIGHTS  ·  Navy bg, real blog collection
       ══════════════════════════════════════════════════════════ -->
  <section class="border-t border-white/[0.04] bg-navy text-cream">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="reveal-up mb-12 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">From the desk</p>
          <h2 class="font-serif text-3xl text-cream sm:text-4xl">Insights &amp; resources</h2>
        </div>
        <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brass transition-colors hover:text-brass-light">
          Visit the blog
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class:list={['grid gap-5', posts.length >= 3 ? 'sm:grid-cols-3' : posts.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-1 sm:max-w-md']}>
        {posts.map((post, i) => (
          <a
            href={`/blog/${post.id}`}
            class="reveal-up flex flex-col rounded-2xl border border-white/10 bg-white/[0.06] p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-brass/30 hover:bg-white/[0.09]"
            style={`animation-delay: ${i * 80}ms`}
          >
            <span class="text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">{post.data.category}</span>
            <h3 class="mt-2 font-serif text-lg text-cream">{post.data.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-cream/65">{post.data.description}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-[0.75rem] font-semibold text-brass">
              Read more
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════
       8. GET IN TOUCH  ·  White bg, callback form
       ══════════════════════════════════════════════════════════ -->
  <ContactCallbackBand />

</BaseLayout>
