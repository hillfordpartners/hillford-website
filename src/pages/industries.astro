---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

// Placeholder sector list — TODO: confirm final industries and descriptions with client.
const industries = [
  'Professional Services',
  'Retail & E-commerce',
  'Real Estate',
  'Technology',
  'Healthcare',
  'Non-profit',
];
---

<BaseLayout
  title="Industries We Serve"
  description="HillFord Partners serves clients across diverse industry sectors with outsourced accounting and finance support."
>
  <PageHero
    eyebrow="Industries"
    title="Experience across diverse sectors"
    subtitle="We support listed entities, privately held companies and family-owned enterprises across a range of industries."
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-xl border border-dashed border-brass/40 bg-white p-6 text-sm text-stone">
      <strong class="text-forest">In progress:</strong> detailed sector descriptions are being finalised. The list below is indicative.
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        industries.map((name) => (
          <div class="rounded-xl border border-brass/20 bg-white p-6">
            <div class="mb-3 h-1 w-10 rounded bg-brass" />
            <h3 class="text-lg text-forest">{name}</h3>
            <p class="mt-2 text-sm text-stone">Tailored outsourced finance support for the {name.toLowerCase()} sector.</p>
          </div>
        ))
      }
    </div>
  </section>

  <CTABand />
</BaseLayout>
