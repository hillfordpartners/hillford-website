---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCallbackBand from '../../components/ContactCallbackBand.astro';
import { services, stats } from '../../data/site';
import { iconFor } from '../../data/serviceIcons';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);
const featured = service.included.slice(0, 2);
const rest = service.included.slice(2);
const overview = `Our ${service.title.toLowerCase()} service gives you accurate, standards-aligned support delivered by a chartered team. We work as an extension of your firm or finance function — handling the detail so you can focus on what matters.`;

const statIcons = [
  'M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m6-4a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm6 0a4 4 0 1 0-3.75-5.5',
  'M12 6.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11zM12 2v2m0 16v2m10-10h-2M4 12H2m15.07-7.07-1.41 1.41M6.34 17.66l-1.41 1.41m12.14 0-1.41-1.41M6.34 6.34 4.93 4.93',
  'M8 7V3m8 4V3M4 11h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z',
  'M9 12l2 2 4-4m5 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
];
---

<BaseLayout title={service.title} description={service.summary}>
  <!-- ══════════════════════════════════════════════════════════
       HERO  ·  Navy bg, title + trust stats
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-navy text-cream">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="flex flex-wrap items-start justify-between gap-10">
        <div class="max-w-xl">
          <p class="mb-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">Service</p>
          <h1 class="font-serif text-3xl text-cream sm:text-4xl">{service.title}</h1>
          <p class="mt-4 leading-relaxed text-cream/70">{service.summary}</p>
        </div>

        <div class="grid grid-cols-2 gap-x-10 gap-y-6">
          {stats.map((stat, i) => (
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/[0.08] text-brass">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={statIcons[i % statIcons.length]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div>
                <p class="font-serif text-xl font-semibold text-cream">{stat.value}{stat.suffix}</p>
                <p class="text-xs text-cream/55">{stat.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       WHAT'S INCLUDED  ·  White bg, featured items + checklist
       ══════════════════════════════════════════════════════════ -->
  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="space-y-16">
        {featured.map((item, i) => (
          <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <div class="mx-auto flex h-44 w-44 items-center justify-center rounded-3xl bg-brass/10 lg:mx-0">
                <svg class="h-16 w-16 text-brass" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={iconFor(service.slug)} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
            <div>
              <h2 class="font-serif text-2xl text-navy">{item}</h2>
              <p class="mt-4 leading-relaxed text-stone">{overview}</p>
              <a href="/contact" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brass transition-colors hover:text-navy">
                Get a proposal
                <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      {rest.length > 0 && (
        <div class="mt-20 border-t border-navy/10 pt-14">
          <h2 class="font-serif text-2xl text-navy">Also included</h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {rest.map((item) => (
              <li class="flex items-start gap-3 text-stone">
                <svg class="mt-1 h-5 w-5 shrink-0 text-brass" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="m5 10 3.5 3.5L15 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-16 grid gap-10 border-t border-navy/10 pt-14 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <h2 class="font-serif text-2xl text-navy">Who it's for</h2>
          <p class="mt-4 leading-relaxed text-stone">{service.whoFor}</p>
        </div>
        <aside>
          <div class="rounded-2xl border border-navy/10 bg-mist p-6">
            <h3 class="font-serif text-lg text-navy">Other services</h3>
            <ul class="mt-3 space-y-2">
              {others.map((s) => (
                <li>
                  <a href={`/services/${s.slug}`} class="text-sm text-navy hover:text-brass">
                    {s.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       GET IN TOUCH  ·  White bg, callback form
       ══════════════════════════════════════════════════════════ -->
  <ContactCallbackBand />
</BaseLayout>
