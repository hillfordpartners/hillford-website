---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import { services } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<BaseLayout title={service.title} description={service.summary}>
  <PageHero eyebrow="Service" title={service.title} subtitle={service.summary} />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3">
      <!-- Main content -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl text-forest">Overview</h2>
        <p class="mt-4 leading-relaxed text-stone">
          Our {service.title.toLowerCase()} service gives you accurate, standards-aligned support delivered by a
          chartered team. We work as an extension of your firm or finance function — handling the detail so you can
          focus on what matters.
        </p>

        <h2 class="mt-10 text-2xl text-forest">What’s included</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            service.included.map((item) => (
              <li class="flex items-start gap-3 text-stone">
                <svg class="mt-1 h-5 w-5 shrink-0 text-brass" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="m5 10 3.5 3.5L15 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-10 text-2xl text-forest">Who it’s for</h2>
        <p class="mt-4 leading-relaxed text-stone">{service.whoFor}</p>
      </div>

      <!-- Sidebar CTA + related -->
      <aside class="lg:col-span-1">
        <div class="sticky top-24 rounded-2xl border border-brass/20 bg-white p-6">
          <h3 class="text-lg text-forest">Get a proposal</h3>
          <p class="mt-2 text-sm text-stone">
            Tell us about your needs and we’ll put together a tailored, transparent proposal.
          </p>
          <a href="/contact" class="mt-4 block rounded-full bg-forest px-5 py-3 text-center text-sm font-semibold text-cream transition-colors hover:bg-forest-light">
            Book a Consultation
          </a>
          <div class="mt-6 border-t border-brass/20 pt-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-stone">Other services</p>
            <ul class="mt-3 space-y-2">
              {
                others.map((s) => (
                  <li>
                    <a href={`/services/${s.slug}`} class="text-sm text-forest hover:text-brass">
                      {s.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <CTABand />
</BaseLayout>
