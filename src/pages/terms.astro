---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Terms & Disclaimer" description="Terms of use and disclaimer for the HillFord Partners website.">
  <PageHero eyebrow="Legal" title="Terms & Disclaimer" />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="space-y-6 leading-relaxed text-stone">
      <div>
        <h2 class="text-xl text-navy">Use of this website</h2>
        <p class="mt-2">
          The content on this website is provided for general information only and does not constitute professional,
          financial, accounting or legal advice. You should seek specific advice before acting on any information here.
        </p>
      </div>
      <div>
        <h2 class="text-xl text-navy">No warranty</h2>
        <p class="mt-2">
          While we aim to keep information accurate and current, HillFord Partners LLP makes no warranties as to the
          completeness or accuracy of the content and accepts no liability for any loss arising from its use.
        </p>
      </div>
      <div>
        <h2 class="text-xl text-navy">Intellectual property</h2>
        <p class="mt-2">
          All content, branding and materials on this site are the property of HillFord Partners LLP unless otherwise
          stated, and may not be reproduced without permission.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
