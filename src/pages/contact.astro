---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, softwarePartners } from '../data/site';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with HillFord Partners to discuss outsourced accounting, bookkeeping and CA services. Book a consultation today."
>
  <!-- ══════════════════════════════════════════════════════════
       HEADER  ·  White bg, centered title
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-white">
    <div class="mx-auto max-w-2xl px-4 pt-16 pb-6 text-center sm:px-6 lg:px-8">
      <h1 class="font-serif text-4xl text-navy sm:text-5xl">Contact Us</h1>
      <p class="mt-4 text-stone">Send us an enquiry or book a consultation call. We respond within one business day.</p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       CONTACT PANEL  ·  Split navy info card + form
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
      <div class="grid overflow-hidden rounded-3xl border border-navy/10 shadow-xl lg:grid-cols-5">
        <!-- Info panel -->
        <div class="relative overflow-hidden bg-navy p-8 text-cream lg:col-span-2 lg:p-10">
          <div class="pointer-events-none absolute -bottom-10 -right-6 h-56 w-56 rounded-full bg-white/[0.05]" aria-hidden="true"></div>
          <div class="pointer-events-none absolute -bottom-2 -right-16 h-40 w-40 rounded-full bg-white/[0.05]" aria-hidden="true"></div>

          <h2 class="relative font-serif text-2xl text-cream">Contact information</h2>
          <p class="relative mt-2 text-sm text-cream/65">Reach us directly, or send an enquiry using the form.</p>

          <dl class="relative mt-10 space-y-6 text-sm">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brass" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 6h16v12H4V6Zm0 0 8 7 8-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <dt class="sr-only">Email</dt>
                <dd><a href={`mailto:${site.email}`} class="text-cream/85 transition-colors hover:text-brass">{site.email}</a></dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brass" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 21s7-6.5 7-11.5a7 7 0 1 0-14 0C5 14.5 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                <circle cx="12" cy="9.5" r="2.25" stroke="currentColor" stroke-width="1.6" />
              </svg>
              <div>
                <dt class="sr-only">Location</dt>
                <dd class="text-cream/85">{site.location}</dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brass" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <dt class="sr-only">Response time</dt>
                <dd class="text-cream/85">{site.responseTime}</dd>
              </div>
            </div>
          </dl>

          <a
            href={site.calendlyUrl}
            class="relative mt-10 inline-flex items-center gap-2 rounded-full bg-brass px-6 py-3 text-sm font-semibold text-navy transition-colors hover:bg-brass-light"
          >
            Book a Consultation
          </a>
        </div>

        <!-- Form -->
        <div class="bg-white p-8 lg:col-span-3 lg:p-10">
          <form
            class="grid gap-5"
            data-enquiry-form
            action="#"
            method="POST"
            data-formspree-id={site.formspreeId}
            novalidate
          >
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-1 block text-sm font-medium text-charcoal">Name <span class="text-brass">*</span></label>
                <input id="name" name="name" type="text" required class="w-full rounded-lg border border-navy/15 bg-white px-4 py-3 focus:border-brass focus:outline-none" />
              </div>
              <div>
                <label for="email" class="mb-1 block text-sm font-medium text-charcoal">Email <span class="text-brass">*</span></label>
                <input id="email" name="email" type="email" required class="w-full rounded-lg border border-navy/15 bg-white px-4 py-3 focus:border-brass focus:outline-none" />
              </div>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="phone" class="mb-1 block text-sm font-medium text-charcoal">Phone <span class="text-stone/60">(optional)</span></label>
                <input id="phone" name="phone" type="tel" class="w-full rounded-lg border border-navy/15 bg-white px-4 py-3 focus:border-brass focus:outline-none" />
              </div>
              <div>
                <label for="company" class="mb-1 block text-sm font-medium text-charcoal">Company</label>
                <input id="company" name="company" type="text" class="w-full rounded-lg border border-navy/15 bg-white px-4 py-3 focus:border-brass focus:outline-none" />
              </div>
            </div>
            <div>
              <label for="persona" class="mb-1 block text-sm font-medium text-charcoal">I am a…</label>
              <select id="persona" name="persona" class="w-full rounded-lg border border-navy/15 bg-white px-4 py-3 focus:border-brass focus:outline-none">
                <option value="firm">Accounting / CPA firm</option>
                <option value="business">Business / SME</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="mb-1 block text-sm font-medium text-charcoal">Message <span class="text-brass">*</span></label>
              <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-navy/15 bg-white px-4 py-3 focus:border-brass focus:outline-none"></textarea>
            </div>
            <!-- Honeypot (spam protection) -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <label class="flex items-start gap-3 text-sm text-stone">
              <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 rounded border-navy/25" />
              <span>I consent to HillFord Partners contacting me about my enquiry. <span class="text-brass">*</span></span>
            </label>
            <button type="submit" class="justify-self-start rounded-full bg-brass px-7 py-3 font-semibold text-navy transition-colors hover:bg-brass-light">
              Send enquiry
            </button>
            <p data-form-note class="hidden rounded-lg bg-mist px-4 py-3 text-sm text-navy"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       PLATFORMS STRIP  ·  Mist bg
       ══════════════════════════════════════════════════════════ -->
  <section class="border-t border-navy/10 bg-mist">
    <div class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <p class="text-[0.6875rem] font-semibold uppercase tracking-widest text-stone">Platforms we work across</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {softwarePartners.map((name) => (
          <span class="text-base font-semibold text-stone/70 transition-colors hover:text-brass">{name}</span>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Contact form — placeholder phase: no backend wired yet.
    // When the Formspree ID is set, swap this for a real POST to https://formspree.io/f/<id>.
    const form = document.querySelector<HTMLFormElement>('[data-enquiry-form]');
    const note = document.querySelector<HTMLParagraphElement>('[data-form-note]');
    const email = 'hello@hillfordpartners.com';
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const id = form.dataset.formspreeId;
      if (id && id !== 'PLACEHOLDER') {
        form.removeEventListener('submit', () => {});
        form.action = `https://formspree.io/f/${id}`;
        form.submit();
        return;
      }
      if (note) {
        note.textContent = `Thanks for reaching out! Online enquiries are launching shortly — please email us at ${email} in the meantime and we’ll respond within one business day.`;
        note.classList.remove('hidden');
      }
      form.reset();
    });
  </script>
</BaseLayout>
