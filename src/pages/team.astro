---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCallbackBand from '../components/ContactCallbackBand.astro';
import { team } from '../data/site';
---

<BaseLayout
  title="Our Team"
  description="Meet the chartered accountants leading HillFord Partners — with audit, advisory and reporting experience from leading global firms."
>
  <!-- ══════════════════════════════════════════════════════════
       LEADERSHIP  ·  Navy bg, large profile cards
       ══════════════════════════════════════════════════════════ -->
  <section class="bg-navy text-cream">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="reveal-up mb-3 inline-flex items-center gap-2 rounded-full border border-brass/30 px-3 py-1 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">
        <span class="h-1.5 w-1.5 rounded-full bg-brass" aria-hidden="true"></span>
        Our leadership
      </div>
      <h1 class="reveal-up max-w-2xl font-serif text-3xl text-cream sm:text-4xl">
        Chartered accountants you can trust with your numbers
      </h1>
      <p class="reveal-up mt-4 max-w-2xl text-[0.9375rem] text-cream/65">
        With over 50 years of combined experience across Big Four firms, multinational organizations, and diverse
        industries, our leadership team delivers reliable Accounting, Finance, Compliance, and CFO solutions.
      </p>

      <div class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2">
        {team.map((member, i) => (
          <div class="reveal-up flex" style={`animation-delay: ${i * 90}ms`}>
            <!-- Photo panel (initials placeholder until real photos are supplied) -->
            <div class="flex aspect-[4/5] w-2/5 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-navy-deep to-navy">
              <span class="font-serif text-6xl font-semibold text-brass/70" aria-hidden="true">{member.initials}</span>
            </div>
            <!-- Content card (overlaps the photo panel) -->
            <div class="-ml-8 mt-8 flex-1 rounded-2xl bg-white p-6 text-charcoal shadow-xl">
              <h3 class="font-serif text-lg text-navy">{member.name}</h3>
              <p class="mt-1 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">{member.designation}</p>
              <p class="mt-3 text-sm leading-relaxed text-stone">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       GET IN TOUCH  ·  White bg, callback form
       ══════════════════════════════════════════════════════════ -->
  <ContactCallbackBand />
</BaseLayout>
