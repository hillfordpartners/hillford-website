---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout
  title="Insights & Resources"
  description="Thought-leadership and practical guidance on outsourced accounting, bookkeeping and finance from HillFord Partners."
>
  <PageHero
    eyebrow="Insights"
    title="Insights & resources"
    subtitle="Practical guidance and thought-leadership on outsourcing, accounting and finance."
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    {
      posts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col rounded-xl border border-brass/20 bg-white p-6 transition-all hover:-translate-y-1 hover:border-brass hover:shadow-lg"
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-brass-dark">{post.data.category}</span>
              <h2 class="mt-2 text-lg text-navy">{post.data.title}</h2>
              <p class="mt-2 flex-1 text-sm text-stone">{post.data.description}</p>
              <span class="mt-4 text-xs text-stone">
                {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-center text-stone">Articles are publishing soon — check back shortly.</p>
      )
    }
  </section>

  <CTABand />
</BaseLayout>
