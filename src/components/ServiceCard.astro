---
import type { Service } from '../data/site';
interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<a
  href={`/services/${service.slug}`}
  class="group flex flex-col rounded-xl border border-brass/20 bg-white p-6 transition-all hover:-translate-y-1 hover:border-brass hover:shadow-lg"
>
  <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-forest/10 text-forest">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 19h16M7 16V8m5 8V5m5 11v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </div>
  <h3 class="text-lg text-forest">{service.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-stone">{service.summary}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brass">
    Learn more
    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
