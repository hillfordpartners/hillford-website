---
import type { TeamMember } from '../data/site';

interface Props {
  members: TeamMember[];
}
const { members } = Astro.props;
---

<section class="bg-navy border-t border-white/[0.04] text-cream">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <!-- Eyebrow -->
    <div class="reveal-up mb-3 inline-flex items-center gap-2 rounded-full border border-brass/30 px-3 py-1 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">
      <span class="h-1.5 w-1.5 rounded-full bg-brass" aria-hidden="true"></span>
      Our leadership
    </div>
    <h2 class="reveal-up font-serif text-3xl text-cream sm:text-4xl">Led by chartered accountants</h2>
    <p class="reveal-up mt-3 max-w-xl text-[0.9375rem] text-cream/65">
      Our leadership brings audit, advisory and reporting expertise from leading global firms.
    </p>

    <!-- Profile cards -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {members.map((member, i) => (
        <div
          class="reveal-up flex gap-5 rounded-2xl border border-navy/10 bg-white p-6"
          style={`animation-delay: ${i * 90}ms`}
        >
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-navy font-serif text-lg font-semibold text-cream" aria-hidden="true">
            {member.initials}
          </div>
          <div>
            <h3 class="font-serif text-base text-navy">{member.name}</h3>
            <p class="mt-0.5 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass-dark">{member.designation}</p>
            <p class="mt-3 text-sm leading-relaxed text-stone">{member.bio}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 flex justify-end">
      <a
        href="/team"
        class="inline-flex items-center gap-2 rounded-full bg-brass px-6 py-3 text-sm font-semibold text-navy transition-colors hover:bg-brass-light"
      >
        Meet the team
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
