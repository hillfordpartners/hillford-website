---
import { services, site, hasCalendlyLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-navy-deep text-cream">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-cream/95 p-2">
          <img src="/images/logo-mark.webp" alt={`${site.legalName} logo`} class="h-full w-full object-contain" width="48" height="48" />
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-cream/70">
          {site.tagline}
        </p>
      </div>

      <!-- Services -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-brass">Services</h3>
        <ul class="space-y-2 text-sm">
          {
            services.map((svc) => (
              <li>
                <a href={`/services/${svc.slug}`} class="text-cream/70 transition-colors hover:text-brass">
                  {svc.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-brass">Company</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="text-cream/70 transition-colors hover:text-brass">About Us</a></li>
          <li><a href="/team" class="text-cream/70 transition-colors hover:text-brass">Our Team</a></li>
          <li><a href="/blog" class="text-cream/70 transition-colors hover:text-brass">Insights</a></li>
          <li><a href="/contact" class="text-cream/70 transition-colors hover:text-brass">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-brass">Get in touch</h3>
        <ul class="space-y-2 text-sm text-cream/70">
          <li><a href={`mailto:${site.email}`} class="transition-colors hover:text-brass">{site.email}</a></li>
          <li>{site.location}</li>
          <li>{site.responseTime}</li>
        </ul>
        <a
          href={hasCalendlyLink ? site.calendlyUrl : '/contact'}
          target={hasCalendlyLink ? '_blank' : undefined}
          rel={hasCalendlyLink ? 'noopener noreferrer' : undefined}
          class="mt-4 inline-block rounded-full bg-brass px-4 py-2 text-sm font-semibold text-navy transition-colors hover:bg-brass-light"
        >
          Book a Consultation
        </a>
      </div>
    </div>

    <div class="mt-12 border-t border-cream/15 pt-6 text-sm text-cream/55 sm:flex sm:items-center sm:justify-between">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <ul class="mt-3 flex gap-4 sm:mt-0">
        <li><a href="/privacy" class="transition-colors hover:text-brass">Privacy Policy</a></li>
        <li><a href="/terms" class="transition-colors hover:text-brass">Terms &amp; Disclaimer</a></li>
      </ul>
    </div>
  </div>
</footer>
