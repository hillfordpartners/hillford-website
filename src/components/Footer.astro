---
import { services, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-forest text-cream">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <img src="/images/logo-mark.png" alt={`${site.legalName} logo`} class="mb-4 h-12 w-auto" width="48" height="48" />
        <p class="max-w-xs text-sm leading-relaxed text-cream/80">
          {site.tagline}
        </p>
      </div>

      <!-- Services -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-brass-light">Services</h3>
        <ul class="space-y-2 text-sm">
          {
            services.map((svc) => (
              <li>
                <a href={`/services/${svc.slug}`} class="text-cream/80 transition-colors hover:text-brass-light">
                  {svc.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-brass-light">Company</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="text-cream/80 transition-colors hover:text-brass-light">About Us</a></li>
          <li><a href="/team" class="text-cream/80 transition-colors hover:text-brass-light">Our Team</a></li>
          <li><a href="/industries" class="text-cream/80 transition-colors hover:text-brass-light">Industries</a></li>
          <li><a href="/blog" class="text-cream/80 transition-colors hover:text-brass-light">Insights</a></li>
          <li><a href="/contact" class="text-cream/80 transition-colors hover:text-brass-light">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-brass-light">Get in touch</h3>
        <ul class="space-y-2 text-sm text-cream/80">
          <li><a href={`mailto:${site.email}`} class="transition-colors hover:text-brass-light">{site.email}</a></li>
          <li>{site.location}</li>
          <li>{site.responseTime}</li>
        </ul>
        <a
          href="/contact"
          class="mt-4 inline-block rounded-full border border-brass px-4 py-2 text-sm font-semibold text-brass-light transition-colors hover:bg-brass hover:text-forest"
        >
          Book a Consultation
        </a>
      </div>
    </div>

    <div class="mt-12 border-t border-cream/15 pt-6 text-sm text-cream/60 sm:flex sm:items-center sm:justify-between">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <ul class="mt-3 flex gap-4 sm:mt-0">
        <li><a href="/privacy" class="transition-colors hover:text-brass-light">Privacy Policy</a></li>
        <li><a href="/terms" class="transition-colors hover:text-brass-light">Terms &amp; Disclaimer</a></li>
      </ul>
    </div>
  </div>
</footer>
