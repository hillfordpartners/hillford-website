---
import type { TeamMember } from '../data/site';
interface Props {
  member: TeamMember;
  teaser?: boolean;
}
const { member, teaser = false } = Astro.props;
---

<div
  class="group flex flex-col items-center rounded-2xl border border-white/[0.08] bg-white/[0.04] backdrop-blur-sm p-7 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brass/25 hover:bg-white/[0.07] hover:shadow-[0_10px_36px_rgba(168,130,60,0.08)]"
>
  <!-- Initials avatar -->
  <div
    class="mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-forest font-serif text-xl font-semibold text-brass-light ring-4 ring-white/10 transition-all duration-300 group-hover:ring-brass/20"
    aria-hidden="true"
  >
    {member.initials}
  </div>

  <h3 class="font-serif text-lg text-cream">{member.name}</h3>
  <p class="mt-1 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">{member.designation}</p>

  {!teaser && (
    <p class="mt-4 text-sm leading-relaxed text-cream/60">{member.bio}</p>
  )}
</div>
