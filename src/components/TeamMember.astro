---
import type { TeamMember } from '../data/site';
interface Props {
  member: TeamMember;
  teaser?: boolean;
}
const { member, teaser = false } = Astro.props;
---

<div class="flex flex-col items-center rounded-xl border border-brass/20 bg-white p-6 text-center">
  <!-- Placeholder avatar (initials) until client supplies photos -->
  <div
    class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-forest font-serif text-2xl font-semibold text-brass-light"
    aria-hidden="true"
  >
    {member.initials}
  </div>
  <h3 class="text-lg text-forest">{member.name}</h3>
  <p class="text-sm font-medium text-brass">{member.designation}</p>
  {!teaser && <p class="mt-3 text-sm leading-relaxed text-stone">{member.bio}</p>}
</div>
