---
import { services, site } from '../data/site';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services', children: services },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  data-header
  class="fixed top-0 left-0 right-0 z-50 border-b border-navy/10 bg-white/90 backdrop-blur-md transition-transform duration-500 ease-out will-change-transform"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label={`${site.name} home`}>
      <img
        src="/images/logowithName_WhiteBg.png"
        alt={`${site.legalName} logo`}
        class="h-10 w-auto transition-opacity duration-300 hover:opacity-85 sm:h-12"
        width="240"
        height="80"
      />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((link) =>
          link.children ? (
            <li class="group relative">
              <a
                href={link.href}
                class:list={[
                  'flex items-center gap-1.5 rounded px-3 py-2 text-sm font-medium transition-colors',
                  isActive(link.href) ? 'text-brass-dark' : 'text-charcoal/75 hover:text-navy',
                ]}
                aria-haspopup="true"
              >
                {link.label}
                <svg class="h-3 w-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <div class="invisible absolute left-0 top-full w-64 translate-y-1 rounded-lg border border-navy/10 bg-white p-2 opacity-0 shadow-xl transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                <a href="/services" class="block rounded px-3 py-2 text-sm font-semibold text-brass-dark hover:bg-navy/5">
                  All Services
                </a>
                {link.children.map((svc) => (
                  <a href={`/services/${svc.slug}`} class="block rounded px-3 py-2 text-sm text-charcoal/75 hover:bg-navy/5 hover:text-navy">
                    {svc.title}
                  </a>
                ))}
              </div>
            </li>
          ) : (
            <li>
              <a
                href={link.href}
                class="group relative inline-block px-3 py-2 text-sm font-medium"
              >
                <span class="relative block h-5 overflow-hidden">
                  <span class="flex flex-col transition-transform duration-500 ease-[cubic-bezier(0.17,0.84,0.44,1)] group-hover:-translate-y-1/2">
                    <span class:list={[
                      'block h-5 leading-5 transition-colors duration-300',
                      isActive(link.href) ? 'text-brass-dark' : 'text-charcoal/75 group-hover:text-navy'
                    ]}>
                      {link.label}
                    </span>
                    <span class="block h-5 leading-5 text-brass-dark">
                      {link.label}
                    </span>
                  </span>
                </span>
                <!-- Underline effect -->
                <span class:list={[
                  'absolute bottom-1 left-3 right-3 h-[1.5px] bg-brass transition-transform duration-500 ease-[cubic-bezier(0.17,0.84,0.44,1)]',
                  isActive(link.href) ? 'scale-x-100' : 'scale-x-0 origin-right group-hover:scale-x-100 group-hover:origin-left'
                ]}></span>
              </a>
            </li>
          )
        )
      }
    </ul>

    <!-- CTA + mobile toggle -->
    <div class="flex items-center gap-2">
      <a
        href="/contact"
        class="hidden rounded-full bg-brass px-5 py-2.5 text-sm font-semibold text-navy transition-colors hover:bg-brass-light hover:shadow-[0_2px_16px_rgba(212,168,75,0.35)] sm:inline-block"
      >
        Book a Consultation
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded p-2 text-navy lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-navy/10 bg-white lg:hidden">
    <ul class="space-y-1 px-4 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded px-3 py-2 text-base font-medium',
                isActive(link.href) ? 'text-brass-dark bg-navy/5' : 'text-charcoal/75 hover:bg-navy/5 hover:text-navy'
              ]}
            >
              {link.label}
            </a>
            {link.children && (
              <ul class="ml-3 border-l border-navy/10 pl-3">
                {link.children.map((svc) => (
                  <li>
                    <a href={`/services/${svc.slug}`} class="block rounded px-3 py-1.5 text-sm text-stone hover:text-brass-dark">
                      {svc.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
      <li class="pt-2">
        <a href="/contact" class="block rounded-full bg-brass px-5 py-2.5 text-center text-sm font-semibold text-navy hover:bg-brass-light">
          Book a Consultation
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Auto-hide and mouse-near-top reveal header behavior
  const header = document.querySelector('[data-header]');
  if (header) {
    let lastScrollY = window.scrollY;
    let isHidden = false;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      const scrollingDown = currentScrollY > lastScrollY;

      if (scrollingDown && currentScrollY > 100) {
        if (!isHidden) {
          header.classList.add('-translate-y-full');
          isHidden = true;
        }
      } else {
        if (isHidden) {
          header.classList.remove('-translate-y-full');
          isHidden = false;
        }
      }
      lastScrollY = currentScrollY;
    }, { passive: true });

    // Track mouse near top edge to reveal a hidden header
    window.addEventListener('mousemove', (e) => {
      if (e.clientY < 60 && isHidden) {
        header.classList.remove('-translate-y-full');
        isHidden = false;
      }
    });
  }
</script>
