---
import { site, hasCalendlyLink } from '../data/site';

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Ready to talk to HillFord?',
  body = 'Book a consultation and tell us about your finance function. We’ll show you how outsourcing can free your team and sharpen your numbers.',
} = Astro.props;
---

<section class="bg-navy">
  <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl text-cream sm:text-4xl">{heading}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-cream/80">{body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href={hasCalendlyLink ? site.calendlyUrl : '/contact'}
        target={hasCalendlyLink ? '_blank' : undefined}
        rel={hasCalendlyLink ? 'noopener noreferrer' : undefined}
        class="rounded-full bg-brass px-7 py-3 font-semibold text-navy transition-colors hover:bg-brass-light"
      >
        Book a Consultation
      </a>
      <a
        href="/services"
        class="rounded-full border border-cream/40 px-7 py-3 font-semibold text-cream transition-colors hover:border-cream"
      >
        Explore Services
      </a>
    </div>
  </div>
</section>
