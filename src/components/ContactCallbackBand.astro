---
import { site } from '../data/site';
---

<section class="border-t border-navy/10 bg-white text-charcoal">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-2 lg:items-start lg:gap-16 lg:px-8">
    <!-- Left copy -->
    <div class="reveal-up">
      <p class="mb-4 text-[0.6875rem] font-semibold uppercase tracking-widest text-brass">Get in touch</p>
      <h2 class="font-serif text-3xl text-navy sm:text-4xl">Get a call back</h2>
      <p class="mt-5 max-w-md text-[0.9375rem] leading-relaxed text-stone">
        Leave your details and a member of our team will reach out to understand your needs and outline how HillFord
        can help.
      </p>
      <div class="mt-8 flex items-center gap-3">
        <div class="h-px w-8 bg-brass/50"></div>
        <span class="text-sm text-stone">{site.responseTime}</span>
      </div>
    </div>

    <!-- Right: form card -->
    <div class="reveal-up" style="animation-delay: 120ms">
      <form
        class="rounded-2xl border border-navy/10 bg-mist p-7"
        data-callback-form
        data-formspree-id={site.formspreeId}
        novalidate
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="cb-name" class="text-xs font-medium text-stone">Your name</label>
            <input
              id="cb-name"
              type="text"
              name="name"
              required
              placeholder="Jane Smith"
              class="rounded-lg border border-navy/15 bg-white px-4 py-3 text-sm text-charcoal placeholder:text-stone/50 transition-all focus:border-brass focus:outline-none"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="cb-email" class="text-xs font-medium text-stone">Email address</label>
            <input
              id="cb-email"
              type="email"
              name="email"
              required
              placeholder="jane@firm.com"
              class="rounded-lg border border-navy/15 bg-white px-4 py-3 text-sm text-charcoal placeholder:text-stone/50 transition-all focus:border-brass focus:outline-none"
            />
          </div>
        </div>

        <div class="mt-4 flex flex-col gap-1.5">
          <label for="cb-phone" class="text-xs font-medium text-stone">
            Phone <span class="text-stone/60">(optional)</span>
          </label>
          <input
            id="cb-phone"
            type="tel"
            name="phone"
            placeholder="+1 555 000 0000"
            class="rounded-lg border border-navy/15 bg-white px-4 py-3 text-sm text-charcoal placeholder:text-stone/50 transition-all focus:border-brass focus:outline-none"
          />
        </div>

        <!-- Honeypot (spam protection) -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <button
          type="submit"
          class="mt-5 w-full rounded-full bg-brass px-7 py-3.5 text-sm font-semibold text-navy transition-all duration-300 hover:bg-brass-light"
        >
          Request a call back
        </button>

        <p data-form-note class="mt-4 hidden text-sm text-brass"></p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ email: site.email }}>
  document.querySelectorAll('[data-callback-form]').forEach((form) => {
    const note = form.querySelector('[data-form-note]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const id = form.dataset.formspreeId;
      if (id && id !== 'PLACEHOLDER') {
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        try {
          const response = await fetch(`https://formspree.io/f/${id}`, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (response.ok) {
            window.location.href = '/thank-you';
            return;
          }
          throw new Error('Formspree submission failed');
        } catch {
          if (note) {
            note.textContent = `Something went wrong sending your details — please email us directly at ${email} in the meantime.`;
            note.classList.remove('hidden');
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
        return;
      }

      if (note) {
        note.textContent = `Thanks! Online enquiries launch shortly — please email us at ${email} in the meantime and we’ll respond within one business day.`;
        note.classList.remove('hidden');
      }
      form.reset();
    });
  });
</script>
